{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "start:passenger": "node server.js",
    "test:config": "node --test tests/production-env.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:public": "node scripts/verify-public.mjs",
    "test:release": "node scripts/with-production.mjs scripts/verify-release.mjs",
    "test:performance": "node scripts/with-production.mjs scripts/measure-public.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1"
}
